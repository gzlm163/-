<Window x:Class="WpfApp1209afvd.Lab4Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1209afvd"
        mc:Ignorable="d"
        Title="Lab4Window" Height="450" Width="850"
        Background="#FF8FAB"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="CustomScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#FFD1DC"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#FFD1DC">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Background="#FF8FAB" BorderBrush="Black" BorderThickness="1">
                                <TextBlock Text="▲" Foreground="Black" FontSize="9" HorizontalAlignment="Center"/>
                            </RepeatButton>
                            <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF5E80" BorderBrush="Black" BorderThickness="1" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Background="#FF8FAB" BorderBrush="Black" BorderThickness="1">
                                <TextBlock Text="▼" Foreground="Black" FontSize="9" HorizontalAlignment="Center"/>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#FF5E80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="#FFD1DC" BorderBrush="Black" BorderThickness="2" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2,4,2" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FF5E80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="border" Background="#FF5E80" BorderBrush="Black" BorderThickness="2" CornerRadius="5" Padding="15,5" Margin="5,3">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#FFD1DC" BorderBrush="Black" BorderThickness="2" CornerRadius="5">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF8FAB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FFD1DC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="#FFD1DC" Padding="10,5">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB6C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFD1DC">
            <MenuItem Header="Действия" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="Построить график" Style="{StaticResource SubMenuItem}" Click="ButtonPlot_Click"/>
                <MenuItem Header="Рассчитать" Style="{StaticResource SubMenuItem}" Click="ButtonCalculate_Click"/>
                <Separator/>
                <MenuItem Header="Очистить" Style="{StaticResource SubMenuItem}" Click="ButtonClear_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Style="{StaticResource SubMenuItem}" Click="ButtonExit_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Функция f(x):" Foreground="Black" FontWeight="Bold" Margin="0,0,0,1"/>
                    <TextBox x:Name="TextBoxFunction" Width="180" Height="26" Margin="0,0,0,6" Style="{StaticResource CustomTextBox}"/>

                    <TextBlock Text="Левая граница a:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,1"/>
                    <TextBox x:Name="TextBoxA" Width="180" Height="26" Margin="0,0,0,6" Style="{StaticResource CustomTextBox}"/>

                    <TextBlock Text="Правая граница b:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,1"/>
                    <TextBox x:Name="TextBoxB" Width="180" Height="26" Margin="0,0,0,6" Style="{StaticResource CustomTextBox}"/>

                    <TextBlock Text="Знаков после запятой:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,1"/>
                    <TextBox x:Name="TextBoxE" Width="180" Height="26" Margin="0,0,0,10" Style="{StaticResource CustomTextBox}"/>

                    <TextBlock Text="Результат:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,1" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TextBoxResult" Width="180" Height="80" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource CustomTextBox}">
                        <TextBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Margin="10" Background="#FFD1DC" BorderBrush="Black" BorderThickness="2" CornerRadius="5">
                <Canvas x:Name="PlotCanvas" ClipToBounds="True"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>