<Window x:Class="WpfApp1209afvd.Lab2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1209afvd"
        mc:Ignorable="d"
        Title="Lab2Window" Height="450" Width="850"
        Background="#E91E63"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="CustomScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#F8BBD0"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#F8BBD0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <RepeatButton Grid.Row="0" 
                                          Command="ScrollBar.LineUpCommand" 
                                          Background="#E91E63" 
                                          BorderBrush="Black" 
                                          BorderThickness="1">
                                <TextBlock Text="▲" Foreground="Black" FontSize="9" HorizontalAlignment="Center"/>
                            </RepeatButton>

                            <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#AD1457" 
                                                        BorderBrush="Black" 
                                                        BorderThickness="1" 
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <RepeatButton Grid.Row="2" 
                                          Command="ScrollBar.LineDownCommand" 
                                          Background="#E91E63" 
                                          BorderBrush="Black" 
                                          BorderThickness="1">
                                <TextBlock Text="▼" Foreground="Black" FontSize="9" HorizontalAlignment="Center"/>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#AD1457"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="#F8BBD0"
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="4,2,4,2"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#AD1457"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="#AD1457" 
                                    BorderBrush="Black" 
                                    BorderThickness="2" 
                                    CornerRadius="5"
                                    Padding="15,5"
                                    Margin="5,3">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#F8BBD0"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        CornerRadius="5">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#880E4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#F8BBD0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="#F8BBD0" Padding="10,5">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F06292"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F8BBD0">
            <MenuItem Header="Действия" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="Построить график" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonPlot_Click"/>
                <MenuItem Header="Найти корни" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonFindRoots_Click"/>
                <Separator/>
                <MenuItem Header="Очистить" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonClear_Click"/>
                <Separator/>
                <MenuItem Header="Выход" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonExit_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Функция f(x):" Foreground="Black" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TextBoxFunction" 
                         Height="26" 
                         Margin="0,0,0,8"
                         Style="{StaticResource CustomTextBox}"/>

                <TextBlock Text="Левая граница a:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TextBoxA" 
                         Height="26" 
                         Margin="0,0,0,8"
                         Style="{StaticResource CustomTextBox}"/>

                <TextBlock Text="Правая граница b:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TextBoxB" 
                         Height="26" 
                         Margin="0,0,0,8"
                         Style="{StaticResource CustomTextBox}"/>

                <TextBlock Text="Точность e:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TextBoxE" 
                         Height="26" 
                         Margin="0,0,0,8"
                         Text="0,0001"
                         Style="{StaticResource CustomTextBox}"/>

                <TextBlock Text="Корни:" Foreground="Black" FontWeight="Bold" Margin="0,5,0,3"/>
                <TextBox x:Name="TextBoxRoots" 
                         Height="110"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource CustomTextBox}">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <Border Grid.Column="1" 
                    Margin="10" 
                    Background="#F8BBD0" 
                    BorderBrush="Black" 
                    BorderThickness="2"
                    CornerRadius="5">
                <Canvas x:Name="PlotCanvas" ClipToBounds="True"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>