<Window x:Class="WpfApp1209afvd.Lab1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1209afvd"
        mc:Ignorable="d"
        Title="Lab1Window" Height="450" Width="850"
        Background="#FF69B4"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="CustomScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#FFB6E1"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#FFB6E1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <RepeatButton Grid.Row="0" 
                                          Command="ScrollBar.LineUpCommand" 
                                          Background="#FF69B4" 
                                          BorderBrush="Black" 
                                          BorderThickness="1">
                                <TextBlock Text="▲" Foreground="Black" FontSize="9" HorizontalAlignment="Center"/>
                            </RepeatButton>

                            <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF1493" 
                                                        BorderBrush="Black" 
                                                        BorderThickness="1" 
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <RepeatButton Grid.Row="2" 
                                          Command="ScrollBar.LineDownCommand" 
                                          Background="#FF69B4" 
                                          BorderBrush="Black" 
                                          BorderThickness="1">
                                <TextBlock Text="▼" Foreground="Black" FontSize="9" HorizontalAlignment="Center"/>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF85C1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#FF85C1"
                                BorderBrush="Black"
                                BorderThickness="0,0,1,1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="5,3"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#FF1493"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="#FFB6E1"
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="4,2,4,2"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="#FF1493" 
                                BorderBrush="Black" 
                                BorderThickness="2" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C71585"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" 
                                    BorderBrush="Black" BorderThickness="2" 
                                    Background="#FFB6E1" CornerRadius="3">
                                <TextBlock x:Name="check" Text="✓" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Visibility="Collapsed" 
                                           Foreground="Black" FontWeight="Bold"/>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="circle" Width="18" Height="18" 
                                    BorderBrush="Black" BorderThickness="2" 
                                    Background="#FFB6E1" CornerRadius="9">
                                <Ellipse x:Name="dot" Width="8" Height="8" 
                                         Fill="Black" Visibility="Collapsed"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinkDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FFB6E1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="#FFB6E1"
                                BorderBrush="Black"
                                BorderThickness="0,0,1,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinkDataGridTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFB6E1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#FF1493"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFB6E1"
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="4,2,4,2"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FF1493"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="#FF1493" 
                                    BorderBrush="Black" 
                                    BorderThickness="2" 
                                    CornerRadius="5"
                                    Padding="15,5"
                                    Margin="5,3">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#FFB6E1"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        CornerRadius="5">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C71585"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FFB6E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="#FFB6E1" Padding="10,5">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF85C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFB6E1">
            <MenuItem Header="Действия" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="Сгенерировать" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonGenerate_Click"/>
                <MenuItem Header="Рассчитать" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonCalculate_Click"/>
                <Separator/>
                <MenuItem Header="Очистить" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonClear_Click"/>
                <Separator/>
                <MenuItem Header="Выход" 
                          Style="{StaticResource SubMenuItem}"
                          Click="ButtonExit_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="15">
                <StackPanel x:Name="SortPanel" Orientation="Vertical">
                    <CheckBox x:Name="CheckBubble" Content="Пузырьковая" Margin="0,0,0,15"
                              Style="{StaticResource CustomCheckBox}"/>

                    <CheckBox x:Name="CheckInsertion" Content="Вставками" Margin="0,0,0,15"
                              Style="{StaticResource CustomCheckBox}"/>

                    <CheckBox x:Name="CheckShaker" Content="Шейкерная" Margin="0,0,0,15"
                              Style="{StaticResource CustomCheckBox}"/>

                    <CheckBox x:Name="CheckQuick" Content="Быстрая" Margin="0,0,0,15"
                              Style="{StaticResource CustomCheckBox}"/>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="CheckBogo" Content="Bogo"
                                  Style="{StaticResource CustomCheckBox}"/>

                        <TextBox x:Name="TextBoxBogoLimit" Width="45" Margin="8,0,0,0" Text="1000"
                                 Style="{StaticResource CustomTextBox}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                    <RadioButton x:Name="RadioAscending" Content="По возрастанию" 
                                 GroupName="Direction"
                                 IsChecked="True" Margin="0,0,0,15"
                                 Style="{StaticResource CustomRadioButton}"/>

                    <RadioButton x:Name="RadioDescending" Content="По убыванию"
                                 GroupName="Direction"
                                 Margin="0,0,0,12"
                                 Style="{StaticResource CustomRadioButton}"/>

                    <TextBlock Text="Способ ввода:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,5"/>

                    <RadioButton x:Name="RadioRandom" Content="Случайный" 
                                 GroupName="InputType"
                                 IsChecked="True" Margin="0,0,0,6"
                                 Style="{StaticResource CustomRadioButton}"/>

                    <RadioButton x:Name="RadioManual" Content="Ручной" 
                                 GroupName="InputType"
                                 Margin="0,0,0,6"
                                 Style="{StaticResource CustomRadioButton}"/>

                    <RadioButton x:Name="RadioFromFile" Content="Из файла" 
                                 GroupName="InputType"
                                 Margin="0,0,0,6"
                                 Style="{StaticResource CustomRadioButton}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="15">
                <TextBlock Text="Исходный массив:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TextBoxInputArray" 
                         Width="340" 
                         Height="60"
                         Margin="0,0,0,10"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource CustomTextBox}">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Результат сортировки:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TextBoxSortedArray" 
                         Width="340" 
                         Height="60"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource CustomTextBox}">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Bottom" 
                        Margin="15,0,0,170">
                <TextBlock Text="a:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Black" FontWeight="Bold"/>
                <TextBox x:Name="TextBoxA" Width="55" Margin="0,0,15,0" Style="{StaticResource CustomTextBox}"/>

                <TextBlock Text="b:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Black" FontWeight="Bold"/>
                <TextBox x:Name="TextBoxB" Width="55" Margin="0,0,15,0" Style="{StaticResource CustomTextBox}"/>

                <TextBlock Text="n:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Black" FontWeight="Bold"/>
                <TextBox x:Name="TextBoxN" Width="55" Style="{StaticResource CustomTextBox}"/>
            </StackPanel>

            <DataGrid x:Name="DataGridManualInput" 
                      Width="340" 
                      Height="140" 
                      Margin="15"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      AutoGenerateColumns="False"
                      Background="#FFB6E1"
                      RowBackground="#FFB6E1"
                      AlternatingRowBackground="#FFB6E1"
                      RowHeaderWidth="0"
                      BorderBrush="Black"
                      BorderThickness="2"
                      FontSize="13"
                      FontWeight="Bold"
                      ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeader}"
                      CellStyle="{StaticResource PinkDataGridCell}"
                      CanUserAddRows="True">
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    <Style TargetType="TextBox" BasedOn="{StaticResource PinkDataGridTextBox}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ручной ввод" Binding="{Binding Value}" Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#FFB6E1"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="CaretBrush" Value="Black"/>
                                <Setter Property="SelectionBrush" Value="#FF1493"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="#FFB6E1"
                                                    BorderBrush="Black"
                                                    BorderThickness="2"
                                                    CornerRadius="3">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              Margin="4,2,4,2"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="DataGridResults" 
                      Width="340" 
                      Height="140" 
                      Margin="15"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      AutoGenerateColumns="False"
                      Background="#FFB6E1"
                      RowBackground="#FFB6E1"
                      AlternatingRowBackground="#FFB6E1"
                      BorderBrush="Black"
                      BorderThickness="2"
                      FontSize="13"
                      FontWeight="Bold"
                      RowHeaderWidth="0"
                      ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeader}"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сортировка" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Итерации" Binding="{Binding Iterations}" Width="95"/>
                    <DataGridTextColumn Header="Время (мс)" Binding="{Binding Time}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>