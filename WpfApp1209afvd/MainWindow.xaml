<Window x:Class="WpfApp1209afvd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1209afvd"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="#FF85C1">

    <Grid>
        <Button Content="1" 
                Width="200" 
                Height="60" 
                Foreground="Black" 
                FontSize="24" 
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                Click="Lab1Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="#FF1493" 
                            BorderBrush="Black" 
                            BorderThickness="4" 
                            CornerRadius="30">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C71585"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="2" 
                Width="90" 
                Height="90" 
                Foreground="Black" 
                FontSize="24" 
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="40,0,0,40"
                Click="Lab2Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="#FFDF0062" 
                            BorderBrush="Black" 
                            BorderThickness="4" 
                            CornerRadius="45">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#880E4F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="3" 
                Width="60" 
                Height="120" 
                Foreground="Black" 
                FontSize="24" 
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,30,50,0"
                Click="Lab3Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="#9575CD" 
                            BorderBrush="Black" 
                            BorderThickness="4">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#7E57C2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="4" 
                Width="120" 
                Height="50" 
                Foreground="Black" 
                FontSize="24" 
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="40,40,0,0"
                Click="Lab4Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="#FF8FAB" 
                            BorderBrush="Black" 
                            BorderThickness="4" 
                            CornerRadius="25">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF5E80"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>